<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>tr.edu.iyte.esgfx</groupId>
    <artifactId>esgfx-web</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>esgfx-web</name>
    <description>Web tool for ESG-Fx based test generation for Software Product Lines</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.esg4aspl</groupId>
            <artifactId>esg-with-feature-expressions</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>

            <!--
                The bundled examples live in the engine submodule, which is their
                single source of truth. Copying them into the jar at build time is
                what lets the jar run from any working directory, and is what makes
                the container image self-contained.
            -->
            <resource>
                <directory>lib/esg-core/files/Cases/SodaVendingMachine</directory>
                <targetPath>examples/SVM</targetPath>
                <includes>
                    <include>SVM_ESGFx.mxe</include>
                    <include>configs/model.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>lib/esg-core/files/Cases/eMail</directory>
                <targetPath>examples/eM</targetPath>
                <includes>
                    <include>eM_ESGFx.mxe</include>
                    <include>configs/model.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>lib/esg-core/files/Cases/Elevator</directory>
                <targetPath>examples/El</targetPath>
                <includes>
                    <include>El_ESGFx.mxe</include>
                    <include>configs/model.xml</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
